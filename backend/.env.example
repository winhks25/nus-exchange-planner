CORS_ORIGINS=http://localhost:3000
API_PORT=8001

# Catalog source. Use json for the frozen rollback snapshot; use postgres only
# after the catalog has been imported and verified.
# A database outage in postgres mode returns 503; switching to json requires
# an explicit configuration change and serves the original source snapshot.
CATALOG_BACKEND=json

# Runtime database credentials. Required only when CATALOG_BACKEND=postgres.
# Use the transaction pooler with the read-only catalog_reader role, for example:
# postgresql://catalog_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Separate credentials for migrations and imports. Never give these to the API
# runtime. Prefer a direct connection or the session pooler where available.
# The importer refuses a different published snapshot; review and verify a
# refresh workflow before changing the source data in production.
IMPORT_DATABASE_URL=

# Bounded connection pool and query timeouts. Values are validated at startup.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=1
DB_POOL_TIMEOUT=5
DB_POOL_MAX_WAITING=16
DB_POOL_CLOSE_TIMEOUT=5
DB_POOL_MAX_LIFETIME=1800
DB_POOL_MAX_IDLE=300
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000
